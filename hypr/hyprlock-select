#!/usr/bin/env bash
# hyprlock-select -- startet den Sperrbildschirm im gewaehlten Stil.
#
# Die Wahl steht in der Shell-Einstellung (Einstellungs-Fenster, Gruppe
# "Sperrbildschirm"):
#
#     ~/.config/dynamic-island/shell.json     "lockscreen": { "style": "..." }
#
#   karte     -> ~/.config/hypr/hyprlock.conf       (Standard, Pillen-Optik)
#   vollbild  -> ~/.config/hypr/hyprlock-full.conf  (grosse Uhr, Wallpaper)
#
# Genutzt wird das Skript von SUPER+L (profiles/*.lua), von hypridle
# (auto-sperren nach Leerlauf) und von der Lock-Kachel der Shell -- alle
# Wege liefern also denselben Stil. Farben holt hyprlock selbst aus
# ~/.config/hypr/scheme/hyprlock.conf, die beim Theme-/Wallpaper-Wechsel
# neu geschrieben wird. Das Auswahl-File wird bei jedem Start frisch gelesen,
# ein Neuladen von Hyprland ist dafuer nicht noetig.

set -u

state="${XDG_CONFIG_HOME:-$HOME/.config}/dynamic-island/shell.json"
card="$HOME/.config/hypr/hyprlock.conf"
full="$HOME/.config/hypr/hyprlock-full.conf"

style=$(jq -r '.lockscreen.style // empty' "$state" 2>/dev/null)

case "$style" in
    vollbild) cfg="$full" ;;
    *)        cfg="$card" ;;
esac

# Fehlt die gewaehlte Datei, bleibt die Standard-Config gewinnen -- ein
# Sperrbildschirm ohne Reste ist immer besser als gar keiner.
if [ ! -r "$cfg" ]; then
    cfg="$card"
fi

# Zweiter Aufruf bringt nichts: ein zweiter hyprlock kann kein zweites
# Session-Lock anlegen ("output already has a session lock surface").
if pgrep -x hyprlock >/dev/null 2>&1; then
    exit 0
fi

exec hyprlock -c "$cfg"
