{
    "$schema": "../plugin.schema.json",
    "id": "wallhaven",
    "name": "Wallhaven",
    "version": "1.0.0",
    "api": 1,
    "author": "Gamecat",
    "icon": "travel_explore",
    "homepage": "https://wallhaven.cc",
    "description": "Wallhaven-Suche in der Wallpaper-Auswahl",
    "defaultEnabled": true,
    "main": "Main.qml",
    "migrateFrom": "wallhaven",
    "keybinds": {
        "open": { "keys": "SUPER + ALT + W", "title": "Wallhaven-Suche", "group": "Werkzeuge", "ipc": "open" }
    },
    "panels": {
        "wallpaper": { "component": "Section.qml", "icon": "travel_explore" }
    },
    "settings": {
        "fullPreview": {
            "default": true,
            "title": "Vorschau in voller Qualität",
            "desc": "Lädt das Vollbild, sobald die Auswahl kurz auf einem Treffer steht"
        },
        "sorting": {
            "default": "top",
            "title": "Sortierung",
            "options": ["relevanz", "neu", "zufall", "views", "favoriten", "top"],
            "labels": { "views": "Aufrufe" }
        },
        "topRange": {
            "default": "1 Monat",
            "title": "Top-Zeitraum",
            "options": ["1 Tag", "3 Tage", "1 Woche", "1 Monat", "3 Monate", "6 Monate", "1 Jahr"],
            "requires": { "sorting": "top" }
        },
        "purity": {
            "default": "sfw",
            "title": "Inhalt",
            "options": ["sfw", "sfw+sketchy"],
            "labels": { "sfw": "Jugendfrei", "sfw+sketchy": "Mit Grenzfällen" }
        },
        "categories": {
            "default": "alle",
            "title": "Kategorien",
            "options": ["alle", "general", "anime", "people", "general+anime"],
            "labels": { "general": "Allgemein", "anime": "Anime", "people": "Personen", "general+anime": "Allgemein + Anime" }
        },
        "atleast": {
            "default": "aus",
            "title": "Mindestauflösung",
            "options": ["aus", "1920x1080", "2560x1440", "3840x2160"],
            "labels": { "1920x1080": "1920 × 1080", "2560x1440": "2560 × 1440", "3840x2160": "3840 × 2160" }
        },
        "ratios": {
            "default": "alle",
            "title": "Seitenverhältnis",
            "options": ["alle", "16x9", "16x10", "21x9"],
            "labels": { "16x9": "16:9", "16x10": "16:10", "21x9": "21:9" }
        }
    }
}
