{
    "$schema": "../plugin.schema.json",
    "id": "overview",
    "name": "Workspace-Übersicht",
    "version": "1.0.0",
    "api": 1,
    "author": "gamecat",
    "icon": "grid_view",
    "description": "Alle Workspaces gekachelt, je Bildschirm ein Tab – als Vollbild oder in der Notch",
    "defaultEnabled": true,
    "main": "Main.qml",
    "keybinds": {
        "toggle": {
            "keys": "SUPER + Tab",
            "title": "Workspace-Übersicht",
            "group": "Workspaces",
            "exec": "hyprctl dispatch 'hl.dsp.global(\"dynamic-island:overview\")'"
        }
    },
    "settings": {
        "style": {
            "default": "vollbild",
            "title": "Ansicht",
            "options": [
                "vollbild",
                "notch"
            ]
        },
        "preview": {
            "default": "auswahl",
            "title": "Vorschau",
            "desc": "Alle Fenster live kostet bei Videos spürbar CPU/GPU",
            "options": [
                "auswahl",
                "alle",
                "aus"
            ],
            "labels": {
                "auswahl": "Gewählte Kachel live",
                "alle": "Alle live",
                "aus": "Standbild"
            }
        },
        "allScreens": {
            "default": true,
            "title": "Auf allen Bildschirmen",
            "desc": "Die Übersicht auf jedem Bildschirm zeigen, sonst nur auf dem fokussierten"
        },
        "empty": {
            "default": false,
            "title": "Leere Workspaces zeigen",
            "desc": "Alle Workspaces der Gruppe als Kachel, nicht nur die mit Fenstern"
        }
    },
    "panels": {
        "notch": {
            "component": "NotchView.qml",
            "icon": "grid_view"
        }
    }
}
