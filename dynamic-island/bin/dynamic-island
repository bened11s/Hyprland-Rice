#!/usr/bin/env python
"""Startskript der dynamic-island-CLI.

Liegt bewusst neben dem Paket statt in site-packages: so ist die CLI Teil des
Dotfiles-Repos (~/.config ist das Repo) und Aenderungen wirken sofort, ohne
Installation. Verlinkt nach ~/.local/bin/dynamic-island.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from dynamic_island import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
