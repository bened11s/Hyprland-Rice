#!/usr/bin/env bash
# hypr-profile — schaltet Hyprland zwischen den Profilen in
# ~/.config/hypr/profiles/*.lua um (siehe ~/.config/hypr/hyprland.lua) und
# verwaltet dabei die zum Profil gehoerende Quickshell-Shell.
#
# Keybind zum Umschalten: CTRL + SUPER + SHIFT + P — geht der Reihe nach durch
# PROFILE_ORDER unten, aktuell caelestia -> simple -> shell2 -> caelestia.

set -uo pipefail

HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
PROFILE_FILE="$HYPR_DIR/profile"
DEFAULT_PROFILE="caelestia"

################################################################################
# Welche Quickshell-Config gehoert zu welchem Profil?
#
# Leerer Wert = das Profil laeuft ohne Shell. Der Wert ist der Name der
# Quickshell-Config, also der Ordner unter ~/.config/quickshell/<name>.
# Diese Tabelle ist die einzige Stelle mit Shell-Namen: Autostart und die
# Shell-Keybinds in profiles/*.lua rufen nur dieses Script auf.
################################################################################
declare -A PROFILE_SHELL=(
    [caelestia]="caelestia"
    [simple]="dynamic-island"
    [shell2]="shell2"
)

# Reihenfolge, in der `hypr-profile toggle` durchschaltet. Ein assoziatives
# Array hat keine feste Reihenfolge, darum hier noch einmal als Liste — und
# sie entscheidet zugleich, welche Namen als Argument gelten. Ein neues Profil
# braucht drei Dinge: profiles/<name>.lua, einen Eintrag oben und einen hier.
PROFILE_ORDER=(caelestia simple shell2)

# Startbefehl je Shell (Schluessel = Shell-Name aus PROFILE_SHELL, nicht der
# Profilname). Ohne Eintrag wird `qs -c <name> -n -d` benutzt — shell2 laeuft
# genau so, ohne eigenen CLI-Wrapper. dynamic-island muss ueber die CLI starten,
# sonst fehlt die MALLOC-Env (shell.py SHELL_ENV).
declare -A SHELL_START=(
    [caelestia]="caelestia shell -d"
    [dynamic-island]="dynamic-island shell -d"
)

# Profile, deren Shell Inaktivitaet selbst verwaltet (sperren, Displays aus,
# ScreenSaver-Inhibit; dynamic-island: modules/services/idle). Dort laeuft
# kein hypridle – sonst sperren beide. Startet die Shell nicht, bleibt
# hypridle als Rueckfall an. Gegenstueck in profiles/<name>.lua:
# `idle_from_shell = true` (hyprland.lua startet hypridle dann nicht).
IDLE_FROM_SHELL=(simple)

die() {
    echo "hypr-profile: $*" >&2
    exit 1
}

usage() {
    cat <<'USAGE'
hypr-profile — Hyprland-Profil umschalten (Keybind: CTRL + SUPER + SHIFT + P)

  hypr-profile                zum naechsten Profil weiterschalten (toggle)
  hypr-profile caelestia      volle Config + Caelestia-Shell
  hypr-profile simple         schlanke Config + Shell dynamic-island
  hypr-profile shell2         schlanke Config + Shell shell2 (im Aufbau)
  hypr-profile status         Profil und Shell-Zustand anzeigen

  hypr-profile shell-sync     Shell an das aktive Profil angleichen (Autostart)
  hypr-profile shell-restart  Shell des aktiven Profils neu starten
  hypr-profile shell-kill     Shell des aktiven Profils beenden

Die Zuordnung Profil -> Quickshell-Config und die Reihenfolge des Toggles
stehen oben in diesem Script (PROFILE_SHELL bzw. PROFILE_ORDER).
USAGE
}

# Meldung ueber Hyprlands eigenes OSD — funktioniert auch ohne Notification-Daemon
notify() {
    local colour="$1" text="$2"
    hyprctl notify -1 4000 "$colour" "$text" >/dev/null 2>&1 || true
    echo "$text"
}

is_profile() {
    local name
    for name in "${PROFILE_ORDER[@]}"; do
        [ "$name" = "$1" ] && return 0
    done
    return 1
}

current_profile() {
    local name=""
    [ -r "$PROFILE_FILE" ] && read -r name < "$PROFILE_FILE"
    if is_profile "$name"; then
        echo "$name"
    else
        echo "$DEFAULT_PROFILE"
    fi
}

# Naechstes Profil im Zyklus — landet am Ende wieder beim ersten
next_profile() {
    local count=${#PROFILE_ORDER[@]} i
    for ((i = 0; i < count; i++)); do
        if [ "${PROFILE_ORDER[i]}" = "$1" ]; then
            echo "${PROFILE_ORDER[(i + 1) % count]}"
            return 0
        fi
    done
    echo "${PROFILE_ORDER[0]}"
}

profile_shell() {
    echo "${PROFILE_SHELL[$1]:-}"
}

shell_exists() {
    local name="$1"
    [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/$name/shell.qml" ] ||
        [ -f "/etc/xdg/quickshell/$name/shell.qml" ]
}

# PIDs einer laufenden Shell (nicht per pkill -f, das trifft die eigene Zeile)
shell_pids() {
    local name="$1" pid
    [ -n "$name" ] || return 0
    for pid in $(pgrep -x qs 2>/dev/null); do
        if tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q -- "-c $name"; then
            echo "$pid"
        fi
    done
}

shell_running() {
    [ -n "$(shell_pids "$1")" ]
}

wait_for() {
    # wait_for <sekunden*10> <condition...>
    local tries="$1"; shift
    local waited=0
    while ! "$@" && [ "$waited" -lt "$tries" ]; do
        sleep 0.1
        waited=$((waited + 1))
    done
    "$@"
}

not_running() {
    ! shell_running "$1"
}

stop_shell() {
    local name="$1" pid
    [ -n "$name" ] || return 0
    shell_running "$name" || return 0

    qs -c "$name" kill >/dev/null 2>&1
    wait_for 20 not_running "$name" && return 0

    # Falls die IPC den Kill nicht angenommen hat: direkt per PID
    for pid in $(shell_pids "$name"); do
        kill "$pid" 2>/dev/null
    done
    wait_for 20 not_running "$name"
}

start_shell() {
    local name="$1"
    [ -n "$name" ] || return 0
    shell_running "$name" && return 0

    if ! shell_exists "$name"; then
        notify "rgb(ffaa00)" "Quickshell-Config '$name' nicht gefunden — Shell nicht gestartet"
        return 1
    fi

    local cmd="${SHELL_START[$name]:-qs -c $name -n -d}"
    # shellcheck disable=SC2086
    setsid -f $cmd >/dev/null 2>&1

    wait_for 50 shell_running "$name"
}

# Shell-Zustand an ein Profil angleichen: fremde verwaltete Shells beenden,
# die eigene starten. Idempotent, braucht keine laufende Hyprland-Instanz.
sync_shell() {
    local profile="$1"
    local desired other name
    desired="$(profile_shell "$profile")"

    for other in "${!PROFILE_SHELL[@]}"; do
        name="${PROFILE_SHELL[$other]}"
        if [ -n "$name" ] && [ "$name" != "$desired" ]; then
            stop_shell "$name" || notify "rgb(ffaa00)" "Shell '$name' laesst sich nicht beenden"
        fi
    done

    if [ -z "$desired" ]; then
        sync_idle "$profile" 1
        return 0
    fi
    start_shell "$desired"
    local rc=$?
    sync_idle "$profile" "$rc"
    return "$rc"
}

# hypridle passend zum Profil: aus, wenn die Shell es uebernimmt (und laeuft),
# sonst an
sync_idle() {
    local profile="$1" shell_failed="$2" own=0 p
    for p in "${IDLE_FROM_SHELL[@]}"; do
        [ "$p" = "$profile" ] && own=1
    done
    if [ "$own" = 1 ] && [ "$shell_failed" = 0 ]; then
        pkill -x hypridle 2>/dev/null
    elif ! pidof -q hypridle; then
        command -v hypridle >/dev/null 2>&1 && setsid -f hypridle >/dev/null 2>&1
    fi
    return 0
}

apply() {
    local target="$1"
    [ -f "$HYPR_DIR/profiles/$target.lua" ] || die "Profil '$target' fehlt ($HYPR_DIR/profiles/$target.lua)"
    command -v hyprctl >/dev/null 2>&1 || die "hyprctl nicht gefunden"
    hyprctl version >/dev/null 2>&1 || die "keine laufende Hyprland-Instanz erreichbar"

    printf '%s\n' "$target" > "$PROFILE_FILE" || die "kann $PROFILE_FILE nicht schreiben"

    # Config neu einlesen: die Weiche in hyprland.lua laedt jetzt das andere Profil
    if ! hyprctl reload >/dev/null 2>&1; then
        die "hyprctl reload fehlgeschlagen — Profil steht auf '$target'"
    fi

    # Faellt die Weiche wegen eines Fehlers auf das Standardprofil zurueck,
    # schreibt sie das in die Profildatei — danach zaehlt dieser Stand.
    local effective
    effective="$(current_profile)"
    if [ "$effective" != "$target" ]; then
        notify "rgb(ff4444)" "Hyprland: Profil '$target' konnte nicht geladen werden, aktiv ist '$effective'"
        target="$effective"
    fi

    # Erst nach dem Reload, damit die Binds des alten Profils schon weg sind
    local desired
    desired="$(profile_shell "$target")"
    if sync_shell "$target"; then
        if [ -n "$desired" ]; then
            notify "rgb(0ED2FC)" "Hyprland: Profil $target (Shell $desired laeuft)"
        else
            notify "rgb(0ED2FC)" "Hyprland: Profil $target (ohne Shell)"
        fi
    else
        notify "rgb(ffaa00)" "Hyprland: Profil $target — Shell '$desired' startet nicht, Log: qs -c $desired log"
    fi

    # Config-Fehler nach dem Wechsel sichtbar machen
    local errors
    errors="$(hyprctl configerrors 2>/dev/null)"
    if [ -n "$errors" ] && [ "$errors" != "no errors" ]; then
        notify "rgb(ff4444)" "Hyprland-Configfehler: $errors"
    fi
}

status() {
    local cur profile name
    cur="$(current_profile)"
    echo "Aktives Profil: $cur"
    echo
    printf '%-12s %-12s %s\n' "PROFIL" "SHELL" "ZUSTAND"
    for profile in "${PROFILE_ORDER[@]}"; do
        name="${PROFILE_SHELL[$profile]}"
        if [ -z "$name" ]; then
            printf '%-12s %-12s %s\n' "$profile" "-" "ohne Shell"
        elif shell_running "$name"; then
            printf '%-12s %-12s %s\n' "$profile" "$name" "laeuft (PID $(shell_pids "$name" | tr '\n' ' '))"
        elif shell_exists "$name"; then
            printf '%-12s %-12s %s\n' "$profile" "$name" "gestoppt"
        else
            printf '%-12s %-12s %s\n' "$profile" "$name" "Config fehlt"
        fi
    done
}

target=""
case "${1:-toggle}" in
    toggle|"")
        target="$(next_profile "$(current_profile)")"
        ;;
    status)
        status
        exit 0
        ;;
    shell-sync)
        sync_shell "$(current_profile)"
        exit $?
        ;;
    shell-restart)
        shell="$(profile_shell "$(current_profile)")"
        if [ -z "$shell" ]; then
            notify "rgb(ffaa00)" "Profil '$(current_profile)' laeuft ohne Shell"
            exit 0
        fi
        stop_shell "$shell"
        start_shell "$shell" || notify "rgb(ffaa00)" "Shell '$shell' startet nicht, Log: qs -c $shell log"
        exit 0
        ;;
    shell-kill)
        shell="$(profile_shell "$(current_profile)")"
        [ -n "$shell" ] && stop_shell "$shell"
        exit 0
        ;;
    -h|--help|help)
        usage
        exit 0
        ;;
    *)
        # Jeder Name aus PROFILE_ORDER ist ein gueltiges Ziel
        if is_profile "$1"; then
            target="$1"
        else
            usage >&2
            exit 1
        fi
        ;;
esac

apply "$target"
