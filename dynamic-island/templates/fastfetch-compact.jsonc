// fastfetch in Schema-Farben, kompakt (~46 Spalten) – siehe templates/fastfetch.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none"
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;{{ primary.ansi }}",
            "output": "default"
        },
        "bar": {
            "width": 8,
            "char": {
                "elapsed": "━",
                "total": "━"
            },
            "border": {
                "left": "",
                "right": ""
            },
            "color": {
                "elapsed": "38;2;{{ primary.ansi }}",
                "total": "38;2;{{ outlineVariant.ansi }}"
            }
        },
        "percent": {
            "type": ["bar"],
            "color": {
                "green": "38;2;{{ onSurfaceVariant.ansi }}",
                "yellow": "38;2;{{ tertiary.ansi }}",
                "red": "38;2;{{ error.ansi }}"
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "key": "\u001b[38;2;{{ tertiary.ansi }}m",
            "format": "\u001b[1;38;2;{{ primary.ansi }}m{user-name}\u001b[0m\u001b[38;2;{{ outline.ansi }}m @ \u001b[0m\u001b[1;38;2;{{ tertiary.ansi }}m{host-name}\u001b[0m"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;{{ outline.ansi }}m╭─\u001b[0m \u001b[1;38;2;{{ tertiary.ansi }}mSystem\u001b[0m"
        },
        { "type": "os", "key": "\u001b[38;2;{{ outline.ansi }}m│\u001b[38;2;{{ primary.ansi }}m 󰣇  OS      ", "format": "{pretty-name}" },
        { "type": "kernel", "key": "\u001b[38;2;{{ outline.ansi }}m│\u001b[38;2;{{ primary.ansi }}m 󰒋  Kernel  ", "format": "{release}" },
        { "type": "uptime", "key": "\u001b[38;2;{{ outline.ansi }}m│\u001b[38;2;{{ primary.ansi }}m 󱎫  Uptime  " },
        { "type": "packages", "key": "\u001b[38;2;{{ outline.ansi }}m│\u001b[38;2;{{ primary.ansi }}m 󰏗  Pakete  ", "format": "{all}" },
        {
            "type": "custom",
            "format": "\u001b[38;2;{{ outline.ansi }}m├─\u001b[0m \u001b[1;38;2;{{ tertiary.ansi }}mHardware\u001b[0m"
        },
        { "type": "cpu", "key": "\u001b[38;2;{{ outline.ansi }}m│\u001b[38;2;{{ primary.ansi }}m 󰻠  CPU     ", "format": "{name}" },
        { "type": "gpu", "key": "\u001b[38;2;{{ outline.ansi }}m│\u001b[38;2;{{ primary.ansi }}m 󰍛  GPU     ", "format": "{name}", "hideType": "integrated" },
        { "type": "memory", "key": "\u001b[38;2;{{ outline.ansi }}m│\u001b[38;2;{{ primary.ansi }}m 󰘚  RAM     ", "format": "{percentage-bar} {used} / {total}" },
        { "type": "disk", "key": "\u001b[38;2;{{ outline.ansi }}m│\u001b[38;2;{{ primary.ansi }}m 󰋊  Disk    ", "format": "{size-percentage-bar} {size-used} / {size-total}", "folders": "/" },
        {
            "type": "custom",
            "format": "\u001b[38;2;{{ outline.ansi }}m├─\u001b[0m \u001b[1;38;2;{{ tertiary.ansi }}mDesktop\u001b[0m"
        },
        { "type": "wm", "key": "\u001b[38;2;{{ outline.ansi }}m│\u001b[38;2;{{ primary.ansi }}m 󰕮  WM      ", "format": "{pretty-name}" },
        { "type": "command",  "key": "\u001b[38;2;{{ outline.ansi }}m│\u001b[38;2;{{ primary.ansi }}m 󰸉  Theme   ", "text": "w=$(cat ~/.local/state/dynamic-island/wallpaper/path.txt); basename \"$(dirname \"$w\")\"", "format": "{result} \u001b[38;2;{{ outline.ansi }}m· {{ mode }}\u001b[0m" },
        { "type": "media", "key": "\u001b[38;2;{{ outline.ansi }}m│\u001b[38;2;{{ primary.ansi }}m 󰎈  Musik   ", "format": "{combined:-34}" },
        { "type": "shell", "key": "\u001b[38;2;{{ outline.ansi }}m╰\u001b[38;2;{{ primary.ansi }}m 󰆍  Shell   ", "format": "{pretty-name} {version}" },
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 2
        }
    ]
}
