{
    "shell": {
        "name": "dynamic-island"
    },
    "toggles": {
        "steam": {
            "steam": {
                "enable": true,
                "match": [{"class": "steam", "title": "Steam"}],
                "command": ["/home/benedikt/.local/bin/steam-clean", "steam://open/main"],
                "move": true
            }
        },
        "sysmon": {
            "btop": {
                "command": ["kitty", "--class", "btop", "--title", "btop", "btop"]
            }
        },
        "specialws": {
            "terminal": {
                "enable": true,
                "match": [{"class": "kitty"}],
                "command": ["kitty"],
                "move": true
            }
        }
    },
    "theme": {
        "enableTerm": false,
        "enableHypr": true,
        "enableHyprlock": true,
        "enableGtk": true,
        "enableQt": true,
        "gtkThemeDark": "Breeze",
        "gtkThemeLight": "Breeze",
        "iconThemeDark": "breeze-dark",
        "iconThemeLight": "breeze",
        "postHook": "python $HOME/.config/dynamic-island/scripts/sync-desktop-theme.py",
        "enableBtop": false,
        "enableCava": true,
        "enableDiscord": false,

        "enableFuzzel": true,
        "enableChromium": false,
        "enableSpicetify": false,
        "enableZed": false,
        "enableHtop": false,
        "enableNvtop": false,
        "enablePandora": false,
        "enableWarp": false
    }
}
