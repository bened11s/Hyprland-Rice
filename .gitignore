# Nur die eigene Rice-Konfig tracken, alles andere ignorieren:
/*
!/hypr/
!/quickshell/
!/dynamic-island/
!/README.md
!/screenshots/
# Die eigenen Wallpaper (die Sammlung aus dem fremden Repo bleibt draussen)
!/wallpapers/
!/hyprlock/
!/nvim/

# innerhalb von quickshell nur die eigene Shell
/quickshell/*
!/quickshell/dynamic-island/

# Shell-Einstellungen: pro Rechner, die Vorgaben stehen im Code
# (quickshell/dynamic-island/modules/services/config/Config.qml)
/dynamic-island/shell.json
# Plugins an/aus + Einstellungswerte: ebenfalls pro Rechner
/dynamic-island/plugins.json
# Neu belegte/abgeschaltete und eigene Tastenkuerzel (SUPER+K, Bearbeiten)
/dynamic-island/keybinds.json

# lokale/privates
.claude/
.qmlls.ini
__pycache__/
*.pyc

# hyprlock: die Bildersammlung aus dem fremden Repo bleibt draussen,
# die Layouts/Skripte werden getrackt
/hyprlock/wallpapers/

# Aus dem Farbschema erzeugt (dynamic-island scheme/wallpaper). Aendert sich
# bei jedem Theme- und Wallpaperwechsel -- gehoert nicht in die Versionierung.
# Die Vorlagen bleiben getrackt: hypr/scheme/default.lua und
# dynamic-island/src/dynamic_island/data/templates/hyprlock.conf.
# install.sh (seed_scheme) legt beide nach einem frischen Clone wieder an.
/hypr/scheme/current.lua
/hypr/scheme/hyprlock.conf

# Zustand, keine Konfiguration: welches Profil und welches Theme gerade laufen.
# Beides schreiben hypr-profile bzw. theme-set bei jedem Umschalten neu und es
# ist pro Rechner verschieden. Ohne die Dateien geht nichts kaputt: hyprland.lua
# faellt auf "caelestia" zurueck (install.sh -> hypr_profile legt "simple" an),
# Colors.qml auf das Theme "ink".
/hypr/profile
/quickshell/dynamic-island/themes/current

# Reste von Merges und Skripten, die eine Datei ueber eine .tmp neu schreiben
*.orig
*.rej
*.tmp

# Spicetify: nur das eigene Theme "Island" + die Queue-Extension. color.ini ist
# ein Symlink auf Themes/dynamic-island/color.ini (schreibt die dynamic-island-CLI
# bei jedem Schemawechsel, enableSpicetify in cli.json).
!/spicetify/
/spicetify/*
!/spicetify/Themes/
/spicetify/Themes/*
!/spicetify/Themes/Island/
!/spicetify/config-xpui.ini
!/spicetify/Extensions/
/spicetify/Extensions/*
!/spicetify/Extensions/islandQueue.js

# Spotify-Lag-Fix: GPU-Prozess darf WAYLAND_DISPLAY nicht sehen (sonst Crash ->
# Software-Rendering). Gilt fuer spotify-launcher bzw. den caelestia-Musik-Toggle
# (startet ueber `spicetify watch -s`, darum dort `env WAYLAND_DISPLAY=`).
!/spotify-launcher.conf
!/caelestia/
/caelestia/*
!/caelestia/cli.json
